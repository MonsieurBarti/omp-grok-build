{
  "name": "omp-grok-build",
  "version": "0.1.0",
  "description": "Oh My Pi provider for Grok Build. OAuth against auth.x.ai, chat on cli-chat-proxy.grok.com, no API-key fallback.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "keywords": [
    "oh-my-pi",
    "omp",
    "extension",
    "grok-build",
    "provider"
  ],
  "engines": {
    "node": ">=22"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "capture/README.md",
    "capture/diff-trace.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "diff-trace": "node --experimental-strip-types capture/diff-trace.ts"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": ">=17",
    "@oh-my-pi/pi-coding-agent": ">=17"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  }
}
